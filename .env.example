###############################################################################
# O ALGORITMO DA APROVAÇÃO — VARIÁVEIS DE AMBIENTE
#
# Copie este arquivo para `.env.local` e preencha os valores.
# `.env.local` está no .gitignore e NUNCA deve ser commitado.
#
# Em produção, cadastre as mesmas variáveis no painel do provedor de deploy.
###############################################################################


# =============================================================================
# BANCO DE DADOS  (obrigatório)
# =============================================================================
# PostgreSQL do Supabase.
#
# Onde achar: Supabase > Project Settings > Database > Connection string > URI
#
# Use a porta 6543 (Transaction Pooler) para a aplicação — serverless abre e
# fecha conexão o tempo todo e o pooler é o que aguenta isso.
# Use a porta 5432 (Session/Direct) apenas para rodar MIGRATIONS.
#
# Atenção: se a senha tiver caracteres especiais, faça URL-encode.
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Conexão direta, usada só por `npm run db:migrate` e pela rotina de backup.
# Se ficar vazia, as migrations usam a DATABASE_URL acima.
DATABASE_URL_DIRECT="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"


# =============================================================================
# AUTENTICAÇÃO E SESSÃO  (obrigatório)
# =============================================================================
# Segredo de assinatura de sessão. Mínimo de 32 caracteres.
# Gere um novo com:  openssl rand -base64 32
#
# Trocar este valor derruba todas as sessões ativas — o que também é a forma
# de emergência de deslogar todo mundo se houver suspeita de vazamento.
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais"

# URL canônica da aplicação. Entra nos links de recuperação de senha e de
# confirmação de e-mail — se estiver errada, o link chega quebrado.
APP_URL="http://localhost:3000"

# Segredo do HMAC que gera a chave pseudônima das métricas (LGPD).
# Gere com:  openssl rand -base64 32
#
# ⚠️ NUNCA guarde este valor dentro do banco nem em backup do banco. É a
#    separação entre os dois que torna a pseudonimização irreversível para
#    quem tiver apenas o dump.
#
# ⚠️ NUNCA rotacione depois que a plataforma estiver no ar. A chave é
#    determinística: trocar o segredo faz a mesma pessoa virar duas na
#    contagem histórica do funil.
ANONYMIZATION_PEPPER="troque-por-outro-segredo-aleatorio-de-32-caracteres-ou-mais"


# =============================================================================
# LEITURA DO EDITAL POR IA  (obrigatório em produção)
# =============================================================================
# API da Anthropic (Claude), usada para ler o PDF do edital e estruturar
# disciplinas, assuntos e pesos.
#
# Onde achar: https://console.anthropic.com/settings/keys
#
# Custo corre por conta da cliente e é proporcional ao uso (README).
# Sem esta chave, o passo 2 do fluxo "+" não funciona.
ANTHROPIC_API_KEY=""


# =============================================================================
# LOGIN COM GOOGLE  (opcional)
# =============================================================================
# Sem estas duas variáveis o botão "Entrar com Google" simplesmente não aparece
# e o login por e-mail e senha continua funcionando normalmente.
#
# Onde pegar: Google Cloud Console > APIs e Serviços > Credenciais >
#             Criar credenciais > ID do cliente OAuth > Aplicativo da Web
#             Passo a passo completo em docs/login-google.md
#
# URIs de redirecionamento autorizados que precisam estar cadastrados lá:
#   http://localhost:3000/api/auth/google/callback     (desenvolvimento)
#   https://SEUDOMINIO.com.br/api/auth/google/callback (produção)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# =============================================================================
# E-MAIL TRANSACIONAL  (obrigatório em produção)
# =============================================================================
# Resend — recuperação de senha e confirmação de troca de e-mail.
#
# Onde achar: https://resend.com/api-keys
#
# Sem esta chave em desenvolvimento, os e-mails são impressos no console
# (driver de log) em vez de enviados. Em produção a aplicação não sobe sem ela.
RESEND_API_KEY=""

# Remetente. O domínio precisa estar verificado no Resend, senão a entrega falha.
EMAIL_FROM="O Algoritmo da Aprovação <nao-responda@seudominio.com.br>"


# =============================================================================
# PAGAMENTOS — MARCO 2  (não é necessário para o Marco 1)
# =============================================================================
# Mercado Pago: assinatura recorrente, Pix e cartão.
#
# Onde achar: https://www.mercadopago.com.br/developers/panel/app
#
# Em desenvolvimento use as credenciais de TESTE (prefixo TEST-).
MERCADOPAGO_ACCESS_TOKEN=""

# Segredo de validação da assinatura dos webhooks. Sem ele, qualquer um pode
# forjar uma notificação de pagamento aprovado.
MERCADOPAGO_WEBHOOK_SECRET=""


# =============================================================================
# OPERAÇÃO
# =============================================================================
# Pula a validação das variáveis acima. Use somente em build de CI que não tem
# acesso aos segredos. Nunca em runtime de produção.
# SKIP_ENV_VALIDATION="1"
